    {
        "id": "8603c9cb8abd75aa",
        "type": "function",
        "z": "b01623ad1a54cc8f",
        "g": "878d230b7785ca2b",
        "name": "Lastgenerator",
        "func": "// ==========================================\n// Konfiguration\n// ==========================================\n\nconst rate = 6500;       // Nachrichten pro Sekunde\nconst value = 42;       // Payload der erzeugten Nachrichten\n\n// Generator-Takt\nconst tickMs = 10;\n\n\n// ==========================================\n// Eingang auswerten\n// ==========================================\n\n// START\nif (msg.payload === true) {\n\n    // Läuft bereits?\n    if (context.get(\"running\")) {\n        node.warn(\"Load Generator läuft bereits\");\n        return null;\n    }\n\n    context.set(\"running\", true);\n\n    const startTime = Date.now();\n    let sent = 0;\n\n\n    // ==========================================\n    // Generator\n    // ==========================================\n\n    function tick() {\n\n        // Wurde inzwischen gestoppt?\n        if (!context.get(\"running\")) {\n            node.status({\n                fill: \"red\",\n                shape: \"ring\",\n                text: `gestoppt (${sent} gesendet)`\n            });\n\n            return;\n        }\n\n        const now = Date.now();\n        const elapsedMs = now - startTime;\n\n        // Anzahl Nachrichten, die laut Sollfrequenz\n        // bis jetzt gesendet worden sein müssten\n        const targetSent = Math.floor(\n            elapsedMs * rate / 1000\n        );\n\n        // Fehlende Nachrichten nachholen\n        const batchSize = targetSent - sent;\n\n        if (batchSize > 0) {\n\n            const messages = new Array(batchSize);\n\n            for (let i = 0; i < batchSize; i++) {\n                messages[i] = {\n                    payload: value\n                };\n            }\n\n            node.send([messages]);\n\n            sent += batchSize;\n        }\n\n\n        // ==========================================\n        // Nächsten Tick absolut ausrichten\n        // ==========================================\n\n        const nextTickNumber =\n            Math.floor(elapsedMs / tickMs) + 1;\n\n        const nextTarget =\n            startTime + nextTickNumber * tickMs;\n\n        const delay =\n            Math.max(0, nextTarget - Date.now());\n\n        setTimeout(tick, delay);\n    }\n\n\n    // ==========================================\n    // Start\n    // ==========================================\n\n    node.status({\n        fill: \"green\",\n        shape: \"dot\",\n        text: `${rate} msg/s`\n    });\n\n    tick();\n\n    return null;\n}\n\n\n// ==========================================\n// STOP\n// ==========================================\n\nif (msg.payload === false) {\n\n    context.set(\"running\", false);\n\n    node.status({\n        fill: \"red\",\n        shape: \"ring\",\n        text: \"gestoppt\"\n    });\n\n    return null;\n}\n\n\n// Andere Eingaben ignorieren\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 200,
        "wires": [
            [
                "a1312dcda9c31284"
            ]
        ]
    },
