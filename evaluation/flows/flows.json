    {
        "id": "4277ea5b6e0abf5b",
        "type": "function",
        "z": "9d5706e660095b00",
        "g": "37b567e3eb33a611",
        "name": "Lastgenerator",
        "func": "// ==========================================\n// Konfiguration\n// ==========================================\n\nconst rate = 2000;    // Nachrichten pro Sekunde\nconst value = 42;       // Payload der erzeugten Nachrichten\n\n// Generator-Takt\nconst tickMs = 10;\n\n\n// ==========================================\n// Eingang auswerten\n// ==========================================\n\n// START\nif (msg.payload === true) {\n\n    // Läuft bereits?\n    if (context.get(\"running\")) {\n        node.warn(\"Load Generator läuft bereits\");\n        return null;\n    }\n\n    context.set(\"running\", true);\n\n    // ==========================================\n    // Benchmark starten\n    // Ausgang 2\n    // ==========================================\n\n    node.send([\n        null,\n        {\n            benchmark: true\n        }\n    ]);\n\n\n    // ==========================================\n    // Lastgenerator initialisieren\n    // ==========================================\n\n    const startTime = Date.now();\n    let sent = 0;\n\n\n    // ==========================================\n    // Generator\n    // ==========================================\n\n    function tick() {\n\n        // Wurde inzwischen gestoppt?\n        if (!context.get(\"running\")) {\n            node.status({\n                fill: \"red\",\n                shape: \"ring\",\n                text: `gestoppt (${sent} gesendet)`\n            });\n\n            return;\n        }\n\n        const now = Date.now();\n        const elapsedMs = now - startTime;\n\n        // Anzahl Nachrichten, die laut Sollfrequenz\n        // bis jetzt gesendet worden sein müssten\n        const targetSent = Math.floor(\n            elapsedMs * rate / 1000\n        );\n\n        // Fehlende Nachrichten nachholen\n        const batchSize = targetSent - sent;\n\n        if (batchSize > 0) {\n\n            const messages = new Array(batchSize);\n\n            for (let i = 0; i < batchSize; i++) {\n                messages[i] = {\n                    payload: value\n                };\n            }\n\n            // ==================================\n            // Last nur über Ausgang 1 senden\n            // ==================================\n\n            node.send([\n                messages,\n                null\n            ]);\n\n            sent += batchSize;\n        }\n\n\n        // ==========================================\n        // Nächsten Tick absolut ausrichten\n        // ==========================================\n\n        const nextTickNumber =\n            Math.floor(elapsedMs / tickMs) + 1;\n\n        const nextTarget =\n            startTime + nextTickNumber * tickMs;\n\n        const delay =\n            Math.max(0, nextTarget - Date.now());\n\n        setTimeout(tick, delay);\n    }\n\n\n    // ==========================================\n    // Start\n    // ==========================================\n\n    node.status({\n        fill: \"green\",\n        shape: \"dot\",\n        text: `${rate} msg/s`\n    });\n\n    tick();\n\n    return null;\n}\n\n\n// ==========================================\n// STOP\n// ==========================================\n\nif (msg.payload === false) {\n\n    context.set(\"running\", false);\n\n    node.status({\n        fill: \"red\",\n        shape: \"ring\",\n        text: \"gestoppt\"\n    });\n\n    return null;\n}\n\n\n// ==========================================\n// Andere Eingaben ignorieren\n// ==========================================\n\nreturn null;",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
