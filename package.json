{
  "name": "node-red-contrib-iec104",
  "version": "0.2.2",
  "description": "Node-RED nodes for IEC 60870-5-104 (IEC 104) communication",
  "keywords": [
    "node-red",
    "iec104",
    "IEC 60870-5-104",
    "telecontrol"
  ],
  "author": "Arbeitskreis integrierte Informationssyteme <aiis@whz.de>",
  "license": "MIT",
  "homepage": "https://github.com/uas-zwickau-aiis/node-red-contrib-iec104",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uas-zwickau-aiis/node-red-contrib-iec104.git"
  },
  "bugs": {
    "url": "https://github.com/uas-zwickau-aiis/node-red-contrib-iec104/issues"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "scripts": {
    "test": "mocha \"test/**/*.spec.js\"",
    "test:unit": "mocha \"test/unit/**/*.spec.js\"",
    "test:integration": "mocha \"test/integration/**/*.spec.js\"",
    "coverage": "nyc --reporter=text --reporter=html npm test"
  },
  "node-red": {
    "version": ">=2.0.0",
    "nodes": {
      "iec104-doublecommand": "iec104-doublecommand.js",
      "iec104-doublepoint": "iec104-doublepoint.js",
      "iec104-integratedtotal": "iec104-integratedtotal.js",
      "iec104-master": "iec104-master.js",
      "iec104-masteraddress": "iec104-masteraddress.js",
      "iec104-measuredvalue": "iec104-measuredvalue.js",
      "iec104-singlecommand": "iec104-singlecommand.js",
      "iec104-singlepoint": "iec104-singlepoint.js",
      "iec104-slave": "iec104-slave.js",
      "iec104-slaveaddress": "iec104-slaveaddress.js",
      "iec104-slaveobserver": "iec104-slaveobserver.js"
    }
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "fast-check": "^4.6.0",
    "mocha": "^11.7.5",
    "nyc": "^18.0.0",
    "sinon": "^21.1.2"
  },
  "dependencies": {
    "hdr-histogram-js": "^3.0.1"
  }
}
